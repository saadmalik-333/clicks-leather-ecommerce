# Disable PHP execution in uploads directory
# Security: Prevents uploaded PHP files from being executed

<FilesMatch "\.(?:php|phtml|php3|php4|php5|phps)$">
    Deny from all
</FilesMatch>

# Also disable script execution via handler
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Block access to hidden files
<FilesMatch "^\.">
    Deny from all
</FilesMatch>
